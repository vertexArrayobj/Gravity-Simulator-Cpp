{
  "version": 8,
  "configurePresets": [
    {
      "name": "linux-gcc-debug",
      "description": "Linux | GCC | Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
